generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Division {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  name       String
  password   String
  roleId     Int
  divisionId Int
  vendorId   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  role       Role      @relation(fields: [roleId], references: [id])
  division   Division  @relation(fields: [divisionId], references: [id])
  sessions   Session[]
}

/// Server-side session store. Tokens are stored as SHA-256 hashes so a
/// database leak cannot be replayed as a valid login.
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Master kategori item. `code` adalah 2 huruf besar yang dipakai sebagai
/// bagian dari kode item otomatis (item 3), mis. AC -> XHIT-AC2610-0001.
model ItemCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Counter nomor urut kode item per kategori per periode YYMM (item 3).
/// Di-increment DI DALAM transaksi pembuatan item, jadi aman untuk import
/// banyak baris sekaligus dan request bersamaan.
model ItemCodeCounter {
  id         Int    @id @default(autoincrement())
  category   String
  period     String
  lastNumber Int    @default(0)

  @@unique([category, period])
}

model MasterItem {
  id       Int      @id @default(autoincrement())
  code     String   @unique
  typeItem String
  namaItem String
  brand    String
  /// Harga satuan acuan (item 12). Nullable + optional, dipakai sebagai sumber
  /// harga otomatis pada form pengajuan (item 8).
  price    Float?
  updateAt DateTime @default(now())
  updateBy String?
}

model MasterVendor {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  serviceType   String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InventoryStock {
  id           Int      @id @default(autoincrement())
  itemCode     String?  @unique
  itemName     String
  category     String
  currentStock Int      @default(0)
  inStock      Int      @default(0)
  outStock     Int      @default(0)
  note         String?
  updatedAt    DateTime @default(now()) @updatedAt
}

model InventoryHistory {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  category String
  stock    Int      @default(0)
  inQty    Int      @default(0)
  outQty   Int      @default(0)
  note     String?
  updateBy String?
}

/// Aset laptop. Kolom baru (item 5) semuanya nullable/defaulted agar data
/// lama tidak rusak.
model LaptopAsset {
  id     Int    @id @default(autoincrement())
  item   String
  user   String
  status String @default("Good")
  date   DateTime @default(now())

  /// Kode aset dari generator item (item 3 + 5). Unique tapi nullable, jadi
  /// baris lama yang belum punya kode tetap valid.
  assetCode       String?  @unique
  /// Kategori aset - laptop selalu "Computer" (item 5).
  category        String?  @default("Computer")
  serialNumber    String?
  specification   String?
  /// Tagihan/alasan mutasi terakhir (ringkasan; riwayat lengkap ada di
  /// AssetAssignmentHistory).
  lastMutationNote String?
  createdBy        String?
  updatedAt        DateTime @default(now()) @updatedAt
  updatedBy        String?

  history AssetAssignmentHistory[]
}

/// Riwayat penugasan aset (item 5). Setiap mutasi menutup baris lama dan
/// membuka baris baru - tidak pernah menimpa.
model AssetAssignmentHistory {
  id        Int      @id @default(autoincrement())
  assetId   Int
  userName  String
  startDate DateTime @default(now())
  endDate   DateTime?
  changedBy String?
  note      String?
  createdAt DateTime @default(now())

  asset LaptopAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([startDate])
}

model BrokenAsset {
  id          Int      @id @default(autoincrement())
  itemType    String
  qty         Int      @default(0)
  brokenCount Int      @default(0)
  note        String?
  date        DateTime @default(now())
}

/// Headset yang dipakai karyawan.
model TransactionItem {
  id                 Int       @id @default(autoincrement())
  vendorSubmissionId Int?
  date               String
  employeeCategory   String
  nik                String
  name               String
  condition          String
  vendor             String
  deposit            Float     @default(0)
  note               String?
  project            String?
  /// Siklus hidup item (item 11): Pending -> Used -> (Good | Damage).
  /// "Return" dipertahankan hanya sebagai alias historis saat baca.
  status             String    @default("Pending")
  approvedBy         String?
  approvedAt         DateTime?
  returnCondition    String?
  returnPrice        Float?
  returnNote         String?
  returnedAt         DateTime?
  /// Katalog item yang dipinjam (dipakai untuk mengembalikan stok, item 11).
  itemCode           String?
  itemName           String?
  updatedAt          DateTime  @default(now()) @updatedAt
  updatedBy          String?
}

/// Daftar aset rusak. Sumber tunggal untuk "jumlah aset rusak" (item 1):
/// hasil Return kondisi Damage, pencatatan manual, dan aset rusak kategori lain.
model DamagedItem {
  id                  Int      @id @default(autoincrement())
  date                DateTime @default(now())
  itemCode            String?
  itemName            String
  qty                 Int      @default(1)
  nik                 String?
  employeeName        String?
  condition           String   @default("Damage")
  vendor              String?
  note                String?
  sourceTransactionId Int?
  createdBy           String?
  createdAt           DateTime @default(now())

  // ---- Kolom baru (item 1, 2, 6) - semua nullable/defaulted ----
  /// Kategori aset rusak, dipakai pencatatan manual (item 6).
  category String?
  /// Siklus layanan: 'Rusak' | 'Dalam Servis' | 'Selesai' | 'Tidak Bisa Diperbaiki'.
  /// Hanya status 'Rusak' dan 'Tidak Bisa Diperbaiki' yang dihitung sebagai
  /// jumlah aset rusak (item 2: kirim ke servis mengurangi jumlah rusak).
  status         String    @default("Rusak")
  /// Id ServisAsset tujuan saat aset dikirim ke servis.
  servisId       Int?
  /// Qty yang dialihkan ke servis (bisa sebagian dari qty di record ini).
  servisQty      Int?
  resolvedAt     DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt
  updatedBy      String?

  @@index([itemCode])
  @@index([status])
}

model StockOutTransaction {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  category    String
  itemCode    String?
  itemName    String
  outQty      Int      @default(1)
  note        String?
  status      String   @default("Pending")
  requestedBy String
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PurchaseRequest {
  id             Int                   @id @default(autoincrement())
  prNumber       String                @unique
  date           DateTime              @default(now())
  typeItem       String
  itemCode       String?
  itemName       String
  /// Harga satuan (item utama, dipertahankan untuk kompatibilitas data lama).
  biaya          Float                 @default(0)
  qty            Int                   @default(1)
  /// Discount level transaksi, nominal Rupiah (item 4).
  diskon         Float                 @default(0)
  /// Biaya kirim level transaksi, nominal Rupiah (item 4).
  shipmentCost   Float                 @default(0)
  /// Total Price = qty x biaya (level transaksi).
  totalPrice     Float                 @default(0)
  /// Grand Total = SUM(item totalPrice) + shipmentCost - diskon (item 4).
  grandTotal     Float                 @default(0)
  note           String?
  details        String?
  status         String                @default("Pending")
  /// Nama pemohon — ditampilkan di PDF dan area tanda tangan (item 5).
  requesterName  String?
  createdBy      String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updateAt       DateTime              @default(now()) @updatedAt
  updateBy       String?
  items          PurchaseRequestItem[]
  deliveryOrders DeliveryOrder[]
}

/// Baris item Purchase Request. Satu PR bisa berisi banyak item (item 4).
model PurchaseRequestItem {
  id              Int             @id @default(autoincrement())
  prId            Int
  itemCode        String?
  itemName        String
  qty             Int             @default(1)
  /// Harga satuan.
  price           Float           @default(0)
  /// qty x price — selalu dihitung ulang di server, tidak mempercayai client.
  totalPrice      Float           @default(0)
  note            String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model DeliveryOrder {
  id              Int              @id @default(autoincrement())
  doNumber        String           @unique
  prId            Int?
  prNumber        String?
  vendorName      String
  itemCode        String?
  itemName        String
  qtyOrdered      Int              @default(0)
  qtyReceived     Int              @default(0)
  /// Harga satuan dari PR — dipakai saat DO selesai diterima untuk menambah stok.
  price           Float            @default(0)
  totalValue      Float            @default(0)
  date            DateTime         @default(now())
  recipient       String
  status          String           @default("Pending")
  note            String?
  receivedAt      DateTime?
  /// Kunci idempotensi "<prId>:<itemCode|nama item>" — menjamin approve ulang
  /// tidak membuat Delivery Order duplikat (item 6).
  dedupeKey       String           @unique
  createdAt       DateTime         @default(now())
  purchaseRequest PurchaseRequest? @relation(fields: [prId], references: [id], onDelete: SetNull)

  @@index([prId])
}

model VendorSubmission {
  id                Int       @id @default(autoincrement())
  submissionCode    String    @unique
  date              DateTime  @default(now())
  vendorName        String
  nik               String?
  karyawanName      String?
  project           String?
  headsetStatus     String?
  title             String
  description       String?
  category          String    @default("Pengajuan Headset")
  proposedPrice     Float     @default(0)
  status            String    @default("Pending")
  adminNote         String?
  /// "Nama Pembuat" pada form Pengajuan (item 14). Nullable untuk data lama.
  namaPembuat       String?
  /// Item katalog yang dipilih saat kategori = Headset (item 13).
  itemCode          String?
  itemName          String?
  /// Salinan harga dari MasterItem saat pengajuan dibuat, agar riwayat harga
  /// pengajuan tidak ikut berubah bila master item diperbarui.
  priceSnapshot     Float?
  /// id PurchaseRequest yang dihasilkan saat pengajuan disetujui (item 11).
  purchaseRequestId Int?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Booking {
  id           Int      @id @default(autoincrement())
  bookingCode  String   @unique
  borrowerName String
  itemType     String
  startDate    String
  startTime    String?
  endDate      String
  endTime      String?
  location     String
  status       String   @default("Pending")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServisAsset {
  id          Int      @id @default(autoincrement())
  servisCode  String   @unique
  date        DateTime @default(now())
  itemName    String
  /// Nullable (item 2): aset yang dikirim dari Daftar Damage belum tentu sudah
  /// punya teknisi. Baris lama tidak terpengaruh.
  teknisiName String?
  status      String   @default("Pending")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Kolom baru (item 2) ----
  /// Asal record aset rusak (DamagedItem.id) bila dibuat dari tombol
  /// "Kirim ke Servis".
  sourceDamageId Int?
  /// Qty aset rusak yang dialihkan ke servis ini.
  sourceQty      Int     @default(0)
  itemCode       String?
  category       String?
  /// Vendor / penyedia jasa servis (opsional).
  serviceVendor  String?
  resolvedAt     DateTime?
  resolutionNote String?
}

model LogRuangServer {
  id        Int      @id @default(autoincrement())
  logCode   String   @unique
  date      DateTime @default(now())
  nama      String
  jamMasuk  String
  jamKeluar String?
  keperluan String
  location  String
  createdAt DateTime @default(now())
}

model RecordingReview {
  id           Int      @id @default(autoincrement())
  reviewCode   String   @unique
  date         DateTime @default(now())
  agenName     String
  nasabahName  String?
  recordingUrl String?
  duration     String?
  reviewedBy   String
  compliance   String
  notes        String?
  createdAt    DateTime @default(now())
}

model Finding {
  id             Int      @id @default(autoincrement())
  findingCode    String   @unique
  date           DateTime @default(now())
  agenName       String
  findingType    String
  severity       String
  description    String
  evidence       String?
  status         String   @default("Open")
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Employee {
  id           Int      @id @default(autoincrement())
  employeeCode String   @unique
  nik          String   @unique
  name         String
  department   String
  position     String
  joinDate     DateTime
  status       String   @default("Active")
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeaveRequest {
  id          Int      @id @default(autoincrement())
  requestCode String   @unique
  employeeId  Int
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("Pending")
  approvedBy  String?
  createdAt   DateTime @default(now())
}

model PaymentAchievement {
  id        Int      @id @default(autoincrement())
  agenName  String
  date      DateTime @default(now())
  amount    Float    @default(0)
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

/// Data nasabah (divisi Ops).
model Nasabah {
  id         Int      @id @default(autoincrement())
  nik        String   @unique
  nama       String
  telepon    String?
  pinjol     Float    @default(0)
  jatuhTempo String?
  assignedTo String?
  status     String   @default("Aktif")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  remarks    Remark[]
}

/// Catatan follow-up terhadap nasabah.
model Remark {
  id           Int       @id @default(autoincrement())
  nasabahId    Int
  agenName     String?
  remark       String
  promiseToPay Boolean   @default(false)
  promiseDate  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  nasabah      Nasabah   @relation(fields: [nasabahId], references: [id], onDelete: Cascade)

  @@index([nasabahId])
}
